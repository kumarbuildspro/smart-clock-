{
  "manifest_version": 3,
  "name": "Digital Clock Generator",
  "version": "1.0.0",
  "description": "A beautiful digital clock with HTML, CSS, and JavaScript",
  "author": "kumarbuildspro",
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [],
  "action": {
    "default_popup": "index.html",
    "default_title": "Digital Clock Generator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
